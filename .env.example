# .env.example — the checklist of every environment variable this app reads.
# Copy to `.env.local` (git-ignored) for local development; secrets live ONLY in
# Vercel environment variables and never in git (09 D-09.6, INV-09.2).
# Names and scopes: 07 §5 and 09 §2. Values are EMPTY except the two safe local
# defaults 07 §5 names: INQUIRY_TRANSPORT=log and the Turnstile test SITE key.
# Nothing in this file is a secret.

# --- Inquiry form: transport (07 §5, 09 §2) ---------------------------------
# `log` prints the rendered email to the terminal instead of calling Resend.
# Deliberately never set in Vercel, so `vercel env pull` cannot deliver it —
# copy this line into .env.local by hand (09 §1, local setup).
INQUIRY_TRANSPORT=log

# Resend key, sending-only, restricted to the sending domain. Preview + prod.
RESEND_API_KEY=

# Optional per-environment OVERRIDES of the sending identity. Unset is the norm:
# the addresses are content, in content/site.json (07 D-07.10, ADJ-24) —
#   from = INQUIRY_FROM_EMAIL -> email.fromAddress
#   to   = INQUIRY_TO_EMAIL   -> email.notifyTo -> contact.email
# INQUIRY_TO_EMAIL is REQUIRED in the Preview scope: a test inbox, never the real
# one. Comma-separated. (09 §2 flags INQUIRY_FROM_EMAIL for removal — OQ-09.11.)
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=

# Auto-acknowledgement to the enquirer: 0 (default) / 1 — 0 until OQ-07.2 says 1.
INQUIRY_AUTOACK=

# --- Cloudflare Turnstile (07 §3, §5) ---------------------------------------
# Local and preview use Cloudflare's published test pair. The SITE key is public
# and ships here as a safe default; the matching always-passes test SECRET is
# `1x0000000000000000000000000000000AA` — put that in .env.local yourself, this
# file keeps every secret-shaped name empty (09 §2).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# --- Site origin (06 D-06.11, 09 §2) ----------------------------------------
# Unset in development and preview (07 §2's origin check falls back to VERCEL_*).
# Production: https://greenpasturesdaycare.com (HD-13).
NEXT_PUBLIC_SITE_URL=

# --- Set by the platform, never here ----------------------------------------
# VERCEL_AUTOMATION_BYPASS_SECRET — Vercel Deployment Protection generates it;
#   it is copied into a GitHub Actions secret for the preview Lighthouse job
#   (09 §2, OQ-08.4) and is never read from a .env file.
# VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL —
#   injected by Vercel on every deployment.
# BEADS_DIR is NOT an application variable (09 §1): it belongs to the tracker
#   shell, not to the app.
