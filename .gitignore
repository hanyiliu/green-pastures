# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Dependencies (pnpm — pnpm-lock.yaml is committed and must never be ignored)
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
*.tsbuildinfo

# Test, coverage and Playwright output.
# Deliberately not anchored with a leading slash: the Playwright config lives under
# tests/e2e/, so its output lands beside it rather than at the repo root.
# tests/e2e/__screenshots__/ holds committed visual baselines and is not matched here.
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# reports/ is not ignored as a directory: reports/section-heights.json is a
# tracked baseline (08-testing-quality.md §12, INV-08.8) — an expectation a human
# reviews when it moves. reports/content-coverage.md is the opposite thing and is
# ignored: a derived aggregate over all of content/**, regenerated by every
# `pnpm validate:content --report` and published by CI three ways (job summary,
# sticky PR comment, artifact). It was tracked until gp-dln.224 and it drifted,
# because a three-way merge cannot add: two content branches that each add one
# `en` key both write the same new total, git merges them without a conflict, and
# the result is wrong. 08 D-08.20 records that; `pnpm check:coverage-report`
# enforces it, and reds the pull request that commits this file again.
reports/content-coverage.md

# Environment. Secrets live in Vercel only (09-deployment-operations.md D-09.6);
# .env.example is committed and matches none of these patterns.
.env
.env*.local
!.env.example

# Lighthouse CI output (PR-8.5). `lhci autorun` writes the collected runs and
# the rendered reports here; the Lighthouse jobs upload the directory as an
# artifact and nothing about it belongs in the repository.
.lighthouseci/

# Vercel
.vercel

# Logs
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# next-intl message declarations — generated beside every content/en JSON by
# `createMessagesDeclaration` (02 D-02.7). Regenerated on every build/dev start.
*.d.json.ts
